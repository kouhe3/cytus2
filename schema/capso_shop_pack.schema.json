{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capso_shop_pack.schema.json",
  "title": "capso_shop_pack",
  "type": "object",
  "required": [
    "id",
    "type",
    "game_id",
    "name",
    "create_order",
    "icon_path",
    "default_price_string",
    "capso_price",
    "available_for_capso",
    "available_for_iap",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^capso_shop_pack/[^\\s]+$"
    },
    "type": {
      "const": "capso_shop_pack"
    },
    "game_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "create_order": {
      "type": "integer"
    },
    "icon_path": {
      "type": "string"
    },
    "default_price_string": {
      "type": "string"
    },
    "capso_price": {
      "type": "integer",
      "minimum": 0
    },
    "available_for_capso": {
      "type": "boolean"
    },
    "available_for_iap": {
      "type": "boolean"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    }
  }
}
