{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "character.schema.json",
  "title": "character",
  "type": "object",
  "required": [
    "id",
    "type",
    "game_id",
    "name",
    "pack_id",
    "avatar_id",
    "bg_movie",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^character/[^\\s]+$"
    },
    "type": {
      "const": "character"
    },
    "game_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "pack_id": {
      "type": ["string", "null"],
      "pattern": "^pack/[^\\s]+$"
    },
    "avatar_id": {
      "type": ["string", "null"]
    },
    "bg_movie": {
      "type": "object",
      "required": [
        "name",
        "os_file_id",
        "im_file_id",
        "story_id",
        "level_lock_character_id",
        "level_lock_level",
        "need_capso",
        "prefabs"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "os_file_id": {"type": "string"},
        "im_file_id": {"type": "string"},
        "story_id": {"type": "string"},
        "level_lock_character_id": {"type": "string"},
        "level_lock_level": {"type": "integer", "minimum": 0},
        "need_capso": {"type": "boolean"},
        "prefabs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["prefix", "prefab", "weight"],
            "additionalProperties": false,
            "properties": {
              "prefix": {"type": "string"},
              "prefab": {"type": "string"},
              "weight": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    }
  }
}
