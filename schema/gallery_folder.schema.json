{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gallery_folder.schema.json",
  "title": "gallery_folder",
  "description": "A Backup Database folder. Distinct from the OS timeline folder entity.",
  "type": "object",
  "required": ["id", "type", "game_id", "name", "avatar_id", "provenance"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^gallery_folder/[^\\s]+$"
    },
    "type": {
      "const": "gallery_folder"
    },
    "game_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "avatar_id": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1}
      ]
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    }
  }
}
