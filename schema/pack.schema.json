{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pack.schema.json",
  "title": "pack",
  "type": "object",
  "required": [
    "id",
    "type",
    "game_id",
    "name",
    "category",
    "theme_color",
    "is_iap",
    "has_im",
    "price",
    "descriptions",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^pack/[^\\s]+$"
    },
    "type": {
      "const": "pack"
    },
    "game_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "theme_color": {
      "type": "string"
    },
    "is_iap": {
      "type": "boolean"
    },
    "has_im": {
      "type": "boolean"
    },
    "price": {
      "type": "string"
    },
    "descriptions": {
      "type": ["object", "null"],
      "additionalProperties": {"type": "string"}
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    }
  }
}
